# Copy to .env and replace both password/key before starting.
POSTGRES_DB=rag_knowledge
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://rag_user:replace-with-local-password@db:5432/rag_knowledge
RAG_API_KEY=replace-with-long-random-api-key
EMBEDDING_MODE=hash
ANSWER_MODE=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
